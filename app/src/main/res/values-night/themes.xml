<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark) -->
    <style name="Base.Theme.MeetoMXH" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/app_bg</item>

        <!-- Typography & Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Outlines & Dividers -->
        <item name="colorOutline">@color/outline_color</item>
        <item name="colorOutlineVariant">@color/divider_color</item>
        <item name="colorError">@color/status_error</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.MeetoMXH" parent="Base.Theme.MeetoMXH" />

    <!-- Modern Card Style -->
    <style name="Widget.Meeto.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_bg</item>
        <item name="cardCornerRadius">@dimen/corner_radius_card</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Outlined Post / Social Card Style -->
    <style name="Widget.Meeto.SocialCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_bg</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Modern Pill Button -->
    <style name="Widget.Meeto.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Soft Neutral Button -->
    <style name="Widget.Meeto.Button.Soft" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Modern Toolbar -->
    <style name="Widget.Meeto.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_bg</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
    </style>

    <!-- Dialog Style -->
    <style name="ThemeOverlay.Meeto.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Meeto.BottomSheet</item>
    </style>

    <style name="Widget.Meeto.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface_bg</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Meeto.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.Meeto.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
