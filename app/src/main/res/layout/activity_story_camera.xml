<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/story_camera_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_reel_camera_action"
            android:padding="14dp"
            android:src="@drawable/ic_reel_close"
            android:contentDescription="@string/story_camera_close"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/story_camera_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/story_camera_subtitle"
                android:textColor="#979BAA"
                android:textSize="11sp" />
        </LinearLayout>

        <Space android:layout_width="48dp" android:layout_height="1dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_story_camera_preview"
        android:clipToOutline="true">

        <androidx.camera.view.PreviewView
            android:id="@+id/story_camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/story_camera_preview"
            app:scaleType="fillCenter" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_reel_gradient"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/story_camera_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="18dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_story_camera_status"
            android:gravity="center"
            android:maxLines="4"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/story_camera_loading"
            android:textColor="#F4F4F8"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/story_camera_mode"
            style="@style/Widget.Meeto.StoryCamera.Action"
            android:layout_width="112dp"
            android:layout_height="44dp"
            android:drawableEnd="@drawable/ic_story_camera_expand"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/story_camera_photo"
            android:textColor="#FF79A6"
            android:textSize="14sp"
            android:contentDescription="@string/story_camera_change_mode" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingHorizontal="20dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/story_camera_mic"
                    style="@style/Widget.Meeto.StoryCamera.Action"
                    android:layout_width="92dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:drawableTop="@drawable/ic_reel_mic"
                    android:drawablePadding="7dp"
                    android:padding="10dp"
                    android:text="@string/story_camera_microphone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_story_camera_shutter_ring">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/story_camera_shutter"
                    style="@style/Widget.Meeto.StoryCamera.Action"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_story_camera_shutter"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/story_camera_capture"
                    android:textColor="#12131A"
                    android:textSize="14sp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/story_camera_flip"
                    style="@style/Widget.Meeto.StoryCamera.Action"
                    android:layout_width="92dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:drawableTop="@drawable/ic_reel_flip"
                    android:drawablePadding="7dp"
                    android:padding="10dp"
                    android:text="@string/story_camera_flip" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:text="@string/story_camera_hint"
            android:textColor="#858A9A"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
