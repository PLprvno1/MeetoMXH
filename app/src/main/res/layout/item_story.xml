<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="76dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Avatar Container with Gradient Story Ring -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal">

        <!-- Instagram 3-Stop Gradient Ring -->
        <FrameLayout
            android:id="@+id/layoutAvatarRing"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/shape_story_ring"
            android:padding="2.5dp">

            <!-- White/Surface gap ring between gradient and avatar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_story_ring_seen"
                android:padding="2dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivStoryAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh đại diện"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_neutral"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            </FrameLayout>

        </FrameLayout>

        <!-- Plus (+) Badge for Creating Story (overlaid at bottom-right) -->
        <ImageView
            android:id="@+id/ivAddStoryIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_button_blue"
            android:contentDescription="Tạo tin"
            android:elevation="2dp"
            android:padding="4dp"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="@color/white" />

        <!-- Hidden Glide target for backward compatibility with StoryAdapter -->
        <ImageView
            android:id="@+id/ivStoryBg"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:contentDescription="@null"
            android:visibility="gone" />

    </FrameLayout>

    <!-- User Name below Story Ring -->
    <TextView
        android:id="@+id/tvStoryUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        tools:text="meeto_user" />

</LinearLayout>
