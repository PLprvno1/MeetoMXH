<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/story_create_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#111114">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="8dp">
  <ImageButton android:id="@+id/story_create_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back" android:tint="#FFFFFF" android:contentDescription="Quay lại" />
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Story" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
  <ImageButton android:id="@+id/story_undo" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_story_undo" android:tint="#FFFFFF" android:contentDescription="Hoàn tác" />
  <ImageButton android:id="@+id/story_redo" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_story_redo" android:tint="#FFFFFF" android:contentDescription="Làm lại" />
  <Button android:id="@+id/story_next" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tiếp" android:textAllCaps="false" android:textColor="#C69AFF" />
 </LinearLayout>
 <HorizontalScrollView android:id="@+id/story_tools" android:layout_width="match_parent" android:layout_height="56dp" android:scrollbars="none">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical">
   <Button android:id="@+id/story_text_tool" style="@style/Widget.Material3.Button.TextButton" android:layout_width="64dp" android:layout_height="48dp" android:text="Aa" android:textColor="#FFFFFF" android:contentDescription="Thêm văn bản" />
   <com.google.android.material.button.MaterialButton android:id="@+id/story_brush_tool" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" app:icon="@drawable/ic_story_brush" app:iconTint="#FFFFFF" android:text="Vẽ" android:textColor="#FFFFFF" android:textAllCaps="false" />
   <com.google.android.material.button.MaterialButton android:id="@+id/story_filter_tool" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" app:icon="@drawable/ic_story_filter" app:iconTint="#FFFFFF" android:text="Filter" android:textColor="#FFFFFF" android:textAllCaps="false" />
   <com.google.android.material.button.MaterialButton android:id="@+id/story_crop_tool" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" app:icon="@drawable/ic_story_crop" app:iconTint="#FFFFFF" android:text="9:16" android:textColor="#FFFFFF" android:textAllCaps="false" />
   <com.google.android.material.button.MaterialButton android:id="@+id/story_rotate_tool" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" app:icon="@drawable/ic_story_rotate" app:iconTint="#FFFFFF" android:text="Xoay" android:textColor="#FFFFFF" android:textAllCaps="false" />
   <com.google.android.material.button.MaterialButton android:id="@+id/story_music_tool" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" app:icon="@drawable/ic_music_note" app:iconTint="#D7B9FF" android:text="Âm nhạc" android:textColor="#FFFFFF" android:textAllCaps="false" />
  </LinearLayout>
 </HorizontalScrollView>
 <TextView android:id="@+id/story_music_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:paddingVertical="2dp" android:textColor="#D7B9FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
 <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#050505">
  <FrameLayout android:id="@+id/story_stage" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintDimensionRatio="9:16" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
   <androidx.media3.ui.PlayerView android:id="@+id/story_edit_player" android:layout_width="match_parent" android:layout_height="match_parent" app:surface_type="surface_view" app:resize_mode="fit" app:use_controller="false" android:visibility="gone" />
   <ImageView android:id="@+id/story_export_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Story thành phẩm" android:visibility="gone" />
   <com.example.meetomxh.ui.StoryCanvasView android:id="@+id/story_canvas" android:layout_width="match_parent" android:layout_height="match_parent" />
  </FrameLayout>
 </androidx.constraintlayout.widget.ConstraintLayout>
 <TextView android:id="@+id/story_create_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:maxLines="3" android:textSize="12sp" android:textColor="#CCCCCC" android:text="Chọn ảnh/video hoặc mở camera để tạo tin" android:accessibilityLiveRegion="polite" />
 <com.example.meetomxh.ui.ReelTrimTimelineView android:id="@+id/story_trim" android:layout_width="match_parent" android:layout_height="104dp" android:visibility="gone" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <Button android:id="@+id/story_pick" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Thư viện" android:textColor="#FFFFFF" android:textAllCaps="false" />
  <ImageButton android:id="@+id/story_camera" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_camera" android:tint="#FFFFFF" android:contentDescription="Chụp ảnh hoặc quay video Story" />
  <ImageButton android:id="@+id/story_edit_play" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reel_pause" android:tint="#FFFFFF" android:contentDescription="Phát hoặc tạm dừng video" android:visibility="gone" />
  <CheckBox android:id="@+id/story_edit_mute" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tắt tiếng" android:textColor="#FFFFFF" android:buttonTint="#C69AFF" android:visibility="gone" />
  <Button android:id="@+id/story_privacy" android:visibility="gone" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Người theo dõi" android:textColor="#FFFFFF" android:textAllCaps="false" />
 </LinearLayout>
 <EditText android:id="@+id/story_create_caption" android:visibility="gone" android:layout_width="match_parent" android:layout_height="48dp" android:paddingHorizontal="16dp" android:hint="Mô tả Story…" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:maxLength="2000" android:singleLine="true" android:inputType="textCapSentences" />
 <ProgressBar android:id="@+id/story_create_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:visibility="gone" />
 <Button android:id="@+id/story_publish" android:visibility="gone" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginHorizontal="12dp" android:text="Xem trước" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#823CE0" />
</LinearLayout>
