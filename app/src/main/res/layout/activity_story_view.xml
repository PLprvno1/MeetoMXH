<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/story_view_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#08080A">
 <com.example.meetomxh.ui.StoryProgressView android:id="@+id/story_segments" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
  <com.google.android.material.imageview.ShapeableImageView android:id="@+id/story_avatar" android:layout_width="38dp" android:layout_height="38dp" android:scaleType="centerCrop" android:contentDescription="Người đăng Story" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
  <TextView android:id="@+id/story_author" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="10dp" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" />
  <ImageButton android:id="@+id/story_pause" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reel_pause" android:contentDescription="Tạm dừng hoặc tiếp tục" android:tint="#FFFFFF" />
  <ImageButton android:id="@+id/story_menu" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more" android:contentDescription="Tùy chọn Story" android:tint="#FFFFFF" />
  <ImageButton android:id="@+id/story_close" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_clear" android:contentDescription="Đóng Story" android:tint="#FFFFFF" />
 </LinearLayout>
 <FrameLayout android:id="@+id/story_touch_area" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <androidx.media3.ui.PlayerView android:id="@+id/story_player" android:layout_width="match_parent" android:layout_height="match_parent" app:surface_type="surface_view" app:resize_mode="fit" app:use_controller="false" android:keepScreenOn="true" />
  <ImageView android:id="@+id/story_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="Nội dung Story" />
  <View android:id="@+id/story_gestures" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" />
  <ProgressBar android:id="@+id/story_loading" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:indeterminateTint="#FFFFFF" />
  <TextView android:id="@+id/story_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:background="#DD151518" android:textColor="#FFFFFF" android:visibility="gone" android:clickable="true" android:focusable="true" />
  <TextView android:id="@+id/story_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="16dp" android:background="#55000000" android:textColor="#FFFFFF" android:maxLines="4" />
 </FrameLayout>
 <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" app:icon="@drawable/ic_story_eye" app:iconTint="#FFFFFF" android:textColor="#FFFFFF" android:id="@+id/story_viewers" android:layout_width="match_parent" android:layout_height="56dp" android:text="Người xem" android:textAllCaps="false" android:visibility="gone" />
 <LinearLayout android:id="@+id/story_reply_bar" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
  <EditText android:id="@+id/story_reply" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_pill_search" android:backgroundTint="#29292D" android:paddingHorizontal="12dp" android:hint="Trả lời…" android:textColor="#FFFFFF" android:textColorHint="#BBBBBB" android:maxLength="2000" android:inputType="textCapSentences" android:imeOptions="actionSend" />
  <ImageButton android:id="@+id/story_send" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_send" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#FFFFFF" android:contentDescription="Gửi trả lời Story" />
  <ImageButton android:id="@+id/story_like" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_like_outline" android:background="?attr/selectableItemBackgroundBorderless" android:tint="#FFFFFF" android:contentDescription="Thả tim Story" />
 </LinearLayout>
</LinearLayout>
