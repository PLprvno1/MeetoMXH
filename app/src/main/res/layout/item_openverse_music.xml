<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:padding="16dp"
    android:orientation="vertical" android:background="@drawable/bg_card_rounded">
    <TextView android:id="@+id/music_item_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/text_primary" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/music_item_creator" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp"
        android:textColor="@color/text_secondary" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/music_item_preview" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp"
            android:text="Nghe thử" android:textAllCaps="false"
            android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" />
        <Button android:id="@+id/music_item_choose" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:text="Chọn bài" android:textAllCaps="false"
            android:backgroundTint="@color/primary_container" android:textColor="@color/on_primary_container" />
    </LinearLayout>
</LinearLayout>
