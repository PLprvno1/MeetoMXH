<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <ProgressBar
        android:id="@+id/playerLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/playerErrorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/playerErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Không thể phát video. Kiểm tra kết nối hoặc quyền xem."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/playerRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thử lại" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/playerClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="Đóng video"
        android:padding="10dp"
        android:src="@drawable/ic_clear"
        android:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/playerMute"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="Tắt tiếng"
        android:padding="10dp"
        android:src="@drawable/ic_volume_on"
        android:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/playerFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="Toàn màn hình"
        android:padding="10dp"
        android:src="@drawable/ic_fullscreen"
        android:tint="#FFFFFF" />
</FrameLayout>
