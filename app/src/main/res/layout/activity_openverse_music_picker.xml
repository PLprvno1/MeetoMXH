<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_picker_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/app_bg" android:paddingHorizontal="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/music_picker_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary" android:contentDescription="Quay lại" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Âm nhạc Openverse" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>
    <EditText android:id="@+id/music_picker_query" android:layout_width="match_parent" android:layout_height="52dp"
        android:singleLine="true" android:imeOptions="actionSearch" android:hint="Tìm bài hát hoặc nghệ sĩ"
        android:inputType="text" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
        android:backgroundTint="@null" android:background="@drawable/bg_music_search" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="56dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/music_picker_categories" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center_vertical" />
    </HorizontalScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp"
        android:text="Chỉ hiện bản nhạc được Openverse ghi nhận CC0. Hãy kiểm tra nguồn và giấy phép trước khi đăng; thông tin này không bảo đảm tuyệt đối về bản quyền."
        android:textColor="@color/text_secondary" android:textSize="12sp" />
    <ProgressBar android:id="@+id/music_picker_progress" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center_horizontal" android:visibility="invisible" />
    <TextView android:id="@+id/music_picker_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:paddingVertical="6dp" android:textColor="@color/text_secondary" android:textSize="13sp"
        android:accessibilityLiveRegion="polite" />
    <ScrollView android:id="@+id/music_picker_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/music_picker_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <com.example.meetomxh.music.MusicMiniPlayer
        android:id="@+id/music_picker_mini" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
    <Button android:id="@+id/music_picker_more" android:layout_width="match_parent" android:layout_height="48dp"
        android:backgroundTint="@color/primary_container" android:textColor="@color/on_primary_container"
        android:text="Xem thêm" android:textAllCaps="false" android:visibility="gone" />
</LinearLayout>
