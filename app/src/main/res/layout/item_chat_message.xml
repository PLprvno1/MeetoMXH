<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/messageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_other"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/tvMessageContext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Đã chuyển tiếp · Đã chỉnh sửa" />

        <TextView
            android:id="@+id/tvReplyPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxWidth="280dp"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="↩ Đang trả lời một tin nhắn trước..." />

        <FrameLayout
            android:id="@+id/layoutMessageMedia"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh hoặc video tin nhắn"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvVideoPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutVoiceMessage"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/btnVoicePlay"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play voice message"
                android:src="@drawable/ic_play"
                tools:ignore="SpeakableTextPresentCheck" />
            <ProgressBar
                android:id="@+id/progressVoicePlayback"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0" />
            <TextView
                android:id="@+id/tvVoiceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="0:08" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:maxWidth="280dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="Xin chào! Đây là tin nhắn trên Meeto." />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            tools:text="10:30" />

        <TextView
            android:id="@+id/tvMessageReceipt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/chat_bubble_mine_secondary"
            android:textSize="9sp"
            android:visibility="gone"
            tools:text="✓ Đã gửi" />

    </LinearLayout>

</LinearLayout>
