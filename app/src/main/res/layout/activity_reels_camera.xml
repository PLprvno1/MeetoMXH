<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reels_camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/reels_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Khung xem trước camera"
        android:keepScreenOn="true" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/reels_camera_video_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reels_camera_countdown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="88sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/reels_camera_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button android:id="@+id/reels_camera_back" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Quay lại" android:text="‹" android:textSize="30sp" />
        <TextView android:id="@+id/reels_camera_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="Camera Reel" android:textColor="#FFFFFF" android:textSize="14sp" />
        <Button android:id="@+id/reels_camera_flash" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Bật hoặc tắt đèn flash" android:text="⚡" />
        <Button android:id="@+id/reels_camera_switch" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Chuyển camera trước sau" android:text="↻" android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reels_camera_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout android:id="@+id/reels_camera_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <Button android:id="@+id/reels_camera_duration_15" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="15 giây" android:textSize="12sp" />
                <Button android:id="@+id/reels_camera_duration_30" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="30 giây" android:textSize="12sp" />
                <Button android:id="@+id/reels_camera_duration_60" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="60 giây" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingEnd="4dp" android:text="Hẹn giờ" android:textColor="#FFFFFF" android:textSize="13sp" />
                <Button android:id="@+id/reels_camera_timer_0" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Tắt" android:textSize="11sp" />
                <Button android:id="@+id/reels_camera_timer_3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="3s" android:textSize="11sp" />
                <Button android:id="@+id/reels_camera_timer_5" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="5s" android:textSize="11sp" />
                <Button android:id="@+id/reels_camera_timer_10" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="10s" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Button android:id="@+id/reels_camera_microphone_state" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:contentDescription="Bật hoặc tắt micro" android:text="Micro: tắt" android:textSize="12sp" />
        <LinearLayout android:id="@+id/reels_camera_recording_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/reels_camera_elapsed" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:text="00:00" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/reels_camera_file_size" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="12dp" android:gravity="center" android:text="0 MB" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/reels_camera_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="1000" android:progress="0" android:progressTint="@color/brand_blue" android:visibility="gone" />

        <LinearLayout android:id="@+id/reels_camera_idle_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <Button android:id="@+id/reels_camera_gallery" android:layout_width="72dp" android:layout_height="56dp" android:contentDescription="Chọn video từ thư viện" android:text="Thư viện" android:textSize="11sp" />
            <Button android:id="@+id/reels_camera_record" android:layout_width="82dp" android:layout_height="82dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:backgroundTint="@color/brand_blue" android:contentDescription="Bắt đầu quay video" android:text="●" android:textColor="#FFFFFF" android:textSize="38sp" />
            <TextView android:layout_width="72dp" android:layout_height="56dp" android:gravity="center" android:text="9:16" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/reels_camera_active_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/reels_camera_cancel" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Hủy quay" />
            <Button android:id="@+id/reels_camera_pause" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Tạm dừng" />
            <Button android:id="@+id/reels_camera_finish" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Dừng" />
        </LinearLayout>

        <LinearLayout android:id="@+id/reels_camera_ready_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/reels_camera_ready_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="6dp" android:textColor="#FFFFFF" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <Button android:id="@+id/reels_camera_retake" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Quay lại" />
                <Button android:id="@+id/reels_camera_preview_mute" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Tắt tiếng nghe" />
                <Button android:id="@+id/reels_camera_continue" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.3" android:backgroundTint="@color/brand_blue" android:text="Tiếp tục" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
