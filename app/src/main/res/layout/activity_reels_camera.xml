<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reels_camera_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.camera.view.PreviewView android:id="@+id/reels_camera_preview" android:layout_width="match_parent"
        android:layout_height="match_parent" android:contentDescription="Khung xem trước camera" android:keepScreenOn="true" app:scaleType="fillCenter" />
    <TextView android:id="@+id/reels_camera_countdown" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:textColor="#FFFFFF" android:textSize="88sp" android:textStyle="bold" android:visibility="gone" />
    <LinearLayout android:id="@+id/reels_camera_top" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:background="#55000000" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/reels_camera_back" style="@style/Widget.Meeto.ReelCamera.Icon" android:src="@drawable/ic_arrow_back" android:contentDescription="Quay lại" />
        <TextView android:id="@+id/reels_camera_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingHorizontal="10dp" android:maxLines="3" android:text="Camera tạo Reel" android:textColor="#FFFFFF" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        <ImageButton android:id="@+id/reels_camera_flash" style="@style/Widget.Meeto.ReelCamera.Icon" android:src="@drawable/ic_reel_flash" android:contentDescription="Bật hoặc tắt đèn flash" />
        <ImageButton android:id="@+id/reels_camera_switch" style="@style/Widget.Meeto.ReelCamera.Icon" android:layout_marginStart="8dp" android:src="@drawable/ic_reel_flip" android:contentDescription="Chuyển camera trước sau" />
    </LinearLayout>
    <ImageButton android:id="@+id/reels_camera_microphone_state" style="@style/Widget.Meeto.ReelCamera.Icon"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp" android:src="@drawable/ic_reel_mic_off" android:contentDescription="Bật microphone để thu âm" />
    <LinearLayout android:id="@+id/reels_camera_bottom" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:gravity="center_horizontal"
        android:background="@drawable/bg_reel_gradient" android:paddingHorizontal="16dp" android:paddingTop="32dp" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/reels_camera_options" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:padding="4dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/reels_camera_duration_15" style="@style/Widget.Meeto.ReelCamera.Duration" android:text="15s" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/reels_camera_duration_30" style="@style/Widget.Meeto.ReelCamera.Duration" android:layout_marginHorizontal="8dp" android:text="30s" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/reels_camera_duration_60" style="@style/Widget.Meeto.ReelCamera.Duration" android:text="60s" />
        </LinearLayout>
        <LinearLayout android:id="@+id/reels_camera_recording_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:visibility="gone">
            <TextView android:id="@+id/reels_camera_elapsed" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:text="00:00" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:id="@+id/reels_camera_file_size" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:layout_marginStart="12dp" android:text="0 MB" android:textColor="#DDDDDD" android:textSize="12sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/reels_camera_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="3dp"
            android:max="1000" android:progressTint="#FF4275" android:visibility="gone" />
        <FrameLayout android:id="@+id/reels_camera_shutter_row" android:layout_width="match_parent" android:layout_height="104dp">
            <LinearLayout android:id="@+id/reels_camera_idle_controls" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical">
                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageButton android:id="@+id/reels_camera_gallery" style="@style/Widget.Meeto.ReelCamera.Icon" android:src="@drawable/ic_reel_gallery" android:contentDescription="Chọn video từ thư viện" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thư viện" android:textColor="#FFFFFF" android:textSize="11sp" />
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <LinearLayout android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <ImageButton android:id="@+id/reels_camera_timer" style="@style/Widget.Meeto.ReelCamera.Icon" android:src="@drawable/ic_reel_timer" android:contentDescription="Hẹn giờ quay" />
                    <TextView android:id="@+id/reels_camera_timer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hẹn giờ" android:textColor="#FFFFFF" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/reels_camera_active_controls" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:visibility="gone">
                <ImageButton android:id="@+id/reels_camera_cancel" style="@style/Widget.Meeto.ReelCamera.Icon" android:src="@drawable/ic_reel_close" android:contentDescription="Hủy bản quay" />
                <ImageButton android:id="@+id/reels_camera_pause" style="@style/Widget.Meeto.ReelCamera.Icon" android:layout_marginStart="4dp" android:src="@drawable/ic_reel_pause" android:contentDescription="Tạm dừng quay" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <Button android:id="@+id/reels_camera_finish" style="@style/Widget.Material3.Button.TextButton" android:layout_width="72dp" android:layout_height="48dp"
                    android:text="Xong" android:textAllCaps="false" android:textColor="#FFFFFF" />
            </LinearLayout>
            <com.example.meetomxh.ui.ReelRecordButton android:id="@+id/reels_camera_record" android:layout_width="84dp" android:layout_height="84dp" android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
