<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/reels_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Quay lại"
            android:src="@drawable/ic_arrow_back" android:tint="#FFFFFF" />
        <TextView android:id="@+id/reels_title" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:text="Reels"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="28sp" />
        <ImageButton android:id="@+id/reels_search" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Tìm kiếm Reels"
            android:src="@drawable/ic_search" android:tint="#FFFFFF" />
        <ImageButton android:id="@+id/reels_more" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Tùy chọn Reel hiện tại"
            android:src="@drawable/ic_more" android:tint="#FFFFFF" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <Button android:id="@+id/reels_mode" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="start|center_vertical" android:paddingHorizontal="0dp"
            android:text="Khám phá · Đang theo dõi" android:textColor="#FFFFFF"
            android:textSize="12sp" android:textAllCaps="false" />
        <ImageButton android:id="@+id/reels_mute" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Bật tiếng"
            android:src="@drawable/ic_volume_off" android:tint="#FFFFFF" />
        <ImageButton android:id="@+id/reels_create" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Tạo Reel"
            android:src="@drawable/ic_add" android:tint="#FFFFFF" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/reels_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" />
        <LinearLayout android:id="@+id/reels_state" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <ProgressBar android:id="@+id/reels_loading" android:layout_width="48dp" android:layout_height="48dp"
                android:indeterminateTint="#FFFFFF" />
            <TextView android:id="@+id/reels_message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="12dp" android:text="Đang tải Reels…" android:textColor="#FFFFFF" android:textSize="16sp" />
            <Button android:id="@+id/reels_retry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Thử lại" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
