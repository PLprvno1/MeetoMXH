<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="220dp" android:layout_margin="2dp"
    android:background="@color/surface_variant" android:contentDescription="Reel">
    <ImageView android:id="@+id/profile_reel_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Ảnh bìa Reel" />
    <TextView android:id="@+id/profile_reel_play" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="#88000000" android:gravity="center" android:text="▶" android:textColor="@color/white" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#99000000" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="4dp">
        <TextView android:id="@+id/profile_reel_views" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:text="◉ 0" android:textColor="@color/white" android:textSize="11sp" />
        <TextView android:id="@+id/profile_reel_likes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:text="♥ 0" android:textColor="@color/white" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
