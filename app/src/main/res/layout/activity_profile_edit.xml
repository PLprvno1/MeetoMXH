<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    tools:context=".ProfileEditActivity">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_bg"
        android:fitsSystemWindows="true"
        app:elevation="1dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_circle"
                    android:clickable="true"
                    android:contentDescription="Quay lại"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvProfileEditTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="-0.01"
                    android:text="Chỉnh sửa trang cá nhân"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnReload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="Tải lại"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Status Indicator / Feedback message (Important: keep ID formStatus) -->
            <TextView
                android:id="@+id/formStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_status_badge"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="@color/brand_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Đã lưu thay đổi"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelUpload"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Hủy tải lên"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryUpload"
                    style="@style/Widget.Meeto.Button.Pill"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Thử tải lại"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- CARD 1: Avatar Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Meeto.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Ảnh đại diện"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickAvatar"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chỉnh sửa"
                            android:textAllCaps="false"
                            android:textColor="@color/brand_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/avatarPreview"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:contentDescription="Xem trước ảnh đại diện"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            app:strokeColor="@color/outline"
                            app:strokeWidth="2dp" />

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/text_primary" />

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <!-- CARD 2: Public Info (Name, Bio) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Meeto.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Thông tin công khai"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Họ và tên"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="Họ và tên"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tiểu sử"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_edittext" android:hint="Tên người dùng (3–30 ký tự)" android:inputType="textNoSuggestions" android:singleLine="true" android:maxLength="30" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                    <EditText
                        android:id="@+id/etBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_edittext"
                        android:gravity="top|start"
                        android:hint="Tiểu sử"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Nơi ở hiện tại (tùy chọn)"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText android:id="@+id/etLocation" android:layout_width="match_parent" android:layout_height="48dp"
                        android:layout_marginTop="4dp" android:background="@drawable/bg_edittext"
                        android:hint="Chọn tỉnh/thành" android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLocationAudience"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="8dp"
                        android:text="Quyền xem nơi ở · Chỉ mình tôi" android:textAllCaps="false" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Ngày sinh"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText android:id="@+id/etDob" android:layout_width="match_parent" android:layout_height="48dp"
                        android:layout_marginTop="4dp" android:background="@drawable/bg_edittext"
                        android:clickable="true" android:drawableEnd="@drawable/ic_calendar"
                        android:drawableTint="@color/text_secondary" android:focusable="false"
                        android:hint="Ngày sinh" android:inputType="datetime" android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="15sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBirthDateAudience"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="8dp"
                        android:text="Quyền xem ngày sinh · Chỉ mình tôi" android:textAllCaps="false" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Giới tính"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText android:id="@+id/etGender" android:layout_width="match_parent" android:layout_height="48dp"
                        android:layout_marginTop="4dp" android:background="@drawable/bg_edittext"
                        android:clickable="true" android:drawableEnd="@drawable/ic_person"
                        android:drawableTint="@color/text_secondary" android:focusable="false"
                        android:hint="Giới tính" android:inputType="text" android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="15sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGenderAudience"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                        android:layout_height="46dp" android:layout_marginTop="8dp"
                        android:text="Quyền xem giới tính · Chỉ mình tôi" android:textAllCaps="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePublic"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:text="Lưu hồ sơ"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_blue"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
