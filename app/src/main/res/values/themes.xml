<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light) -->
    <style name="Base.Theme.MeetoMXH" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/ig_purple</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorAccent">@color/brand_blue</item>
        <item name="android:colorAccent">@color/brand_blue</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/app_bg</item>

        <!-- Typography & Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Outlines & Dividers -->
        <item name="colorOutline">@color/outline_color</item>
        <item name="colorOutlineVariant">@color/divider_color</item>
        <item name="colorError">@color/status_error</item>

        <!-- Shared component defaults -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Meeto.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Meeto.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Meeto.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Meeto.BottomSheetDialog</item>
        <item name="materialButtonStyle">@style/Widget.Meeto.Button.Default</item>
        <item name="buttonStyle">@style/Widget.Meeto.Button.Legacy</item>
        <item name="android:buttonStyle">@style/Widget.Meeto.Button.Legacy</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Meeto.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Meeto.Button.Dialog</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.MeetoMXH" parent="Base.Theme.MeetoMXH" />

    <style name="ThemeOverlay.Meeto.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_window</item>
        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Meeto.Dialog</item>
    </style>

    <style name="ShapeAppearance.Meeto.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_radius_dialog</item>
    </style>

    <style name="Widget.Meeto.Button.Default" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">@dimen/button_height_standard</item>
    </style>

    <style name="Widget.Meeto.Button.Legacy" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_neutral</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/button_height_standard</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.Meeto.Button.Dialog" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_blue</item>
    </style>

    <!-- Modern Card Style -->
    <style name="Widget.Meeto.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_bg</item>
        <item name="cardCornerRadius">@dimen/corner_radius_card</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Outlined Post / Social Card Style -->
    <style name="Widget.Meeto.SocialCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_bg</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Modern Pill Button -->
    <style name="Widget.Meeto.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Soft Neutral Button -->
    <style name="Widget.Meeto.Button.Soft" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Modern Toolbar -->
    <style name="Widget.Meeto.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_bg</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
    </style>

    <!-- Dialog Style -->
    <style name="ThemeOverlay.Meeto.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Meeto.BottomSheet</item>
    </style>

    <style name="Widget.Meeto.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface_bg</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Meeto.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.Meeto.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
